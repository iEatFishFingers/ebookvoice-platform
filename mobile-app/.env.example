# Copy to mobile-app/.env. Expo inlines EXPO_PUBLIC_* values at build time.

# Backend (the Flask API). Defaults to http://localhost:8080 when unset.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Native dev builds on a physical device: your machine's LAN IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_DEV_API_URL=

# Supabase — the API URL and anon key printed by `npx supabase start`
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
