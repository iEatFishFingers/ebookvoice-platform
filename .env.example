# ─────────────────────────────────────────────────────────────────────────────
# EbookVoice backend — copy to .env and fill in.
# Only the Supabase block is required. Everything else is optional: features
# whose keys are missing are simply unavailable (see docs/local-setup.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Local: run `npx supabase start` and copy the values it prints.
#   API URL           → SUPABASE_URL
#   service_role key  → SUPABASE_SERVICE_KEY
#   JWT secret        → SUPABASE_JWT_SECRET
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Origin(s) allowed by CORS — the Expo web dev server runs on :8081.
ALLOWED_ORIGINS=http://localhost:8081
# Base URL clients use to reach this server. Used for locally stored media;
# set it to your machine's LAN IP to test from a phone.
PUBLIC_BASE_URL=http://localhost:8080
# Set to true ONLY when this backend shares a database with another running
# instance — it stops this process claiming queued conversions.
DISABLE_QUEUE_WORKER=false
# Roll the react-native-track-player audio backend out (true) or back (false).
FEATURE_RNTP_ENABLED=true

# ── Media storage (optional) ─────────────────────────────────────────────────
# Leave blank to store audio, covers and karaoke timings on local disk
# (LOCAL_MEDIA_DIR, default ./local_media). Production used Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_MEDIA_DIR=./local_media

# ── Payments (optional) ──────────────────────────────────────────────────────
# Web checkout via Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
APP_URL_WEB=http://localhost:8081/payment
# Mobile IAP via RevenueCat (must be a v1 secret key)
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ── Tuning (optional — code defaults shown) ──────────────────────────────────
# CHUNK_MAX_WORDS=1000
# SYNTH_MAX_ATTEMPTS=4
# SYNTH_BACKOFF_BASE_S=5
# MAX_CONVERSION_WORDS=500000
# MAX_TASK_RETRIES=3
# VOICE_CACHE_TTL_HOURS=168
# LOG_LEVEL=INFO
